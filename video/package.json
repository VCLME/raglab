{
  "name": "raglab-demo-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The raglab demo video: the app driven against a replayed API, animated with Remotion.",
  "scripts": {
    "placeholder": "node scripts/placeholder.mjs",
    "capture": "node scripts/capture.mjs",
    "shots": "node scripts/shots.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "demo": "node scripts/capture.mjs && node scripts/render.mjs --shots",
    "publish": "node scripts/publish.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "playwright": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "typescript": "^5.6.2"
  }
}
