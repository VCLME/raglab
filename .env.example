RAGLAB_DATABASE_URL=postgresql+psycopg://raglab:raglab@localhost:5432/raglab
RAGLAB_OLLAMA_BASE_URL=http://localhost:11434

RAGLAB_GENERATION_MODEL=qwen2.5:7b
RAGLAB_GENERATION_TEMPERATURE=0.1
RAGLAB_GENERATION_TIMEOUT_SECONDS=120
RAGLAB_OLLAMA_PULL_TIMEOUT_SECONDS=7200

RAGLAB_EMBEDDING_PROVIDER=transformers
RAGLAB_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RAGLAB_EMBEDDING_DIMENSION=384
RAGLAB_EMBEDDING_DEVICE=cpu
RAGLAB_EMBEDDING_MAX_TOKENS=512
RAGLAB_QUERY_PREFIX="query: "
RAGLAB_PASSAGE_PREFIX="passage: "

RAGLAB_DEFAULT_CORPUS_NAME=default
RAGLAB_DEFAULT_TOP_K=5

# Hybrid retrieval (docs/retrieval-hybrid.md): dense | lexical | hybrid
RAGLAB_DEFAULT_RETRIEVAL_MODE=hybrid
RAGLAB_DEFAULT_LANGUAGE=fr
RAGLAB_BM25_K1=1.2
RAGLAB_BM25_B=0.75
RAGLAB_RRF_K=60
RAGLAB_HYBRID_LEXICAL_WEIGHT=0.5
RAGLAB_HYBRID_CANDIDATES=50

# Re-ranking cross-encoder (phase 9.3, docs/reranking.md). fp16 sur CUDA, ~1,1 Go de VRAM.
RAGLAB_DEFAULT_RERANK=true
RAGLAB_RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RAGLAB_RERANK_DEVICE=cuda
RAGLAB_RERANK_CANDIDATES=40
RAGLAB_RERANK_BATCH_SIZE=16
RAGLAB_RERANK_MAX_LENGTH=512
RAGLAB_RERANK_CACHE_SIZE=20000
RAGLAB_RERANK_TIMEOUT_SECONDS=60
# Sans GPU : skip (le re-ranking par defaut est saute, la reponse le dit) ou cpu (plusieurs secondes par requete).
RAGLAB_RERANK_WITHOUT_GPU=skip

RAGLAB_CHUNK_SIZE=900
RAGLAB_CHUNK_OVERLAP=150
RAGLAB_SLIDE_WINDOW_SIZE=900
RAGLAB_SLIDE_STRIDE=300
RAGLAB_LATE_CHUNK_SIZE=700
RAGLAB_LATE_CONTEXT_CHARS=500

RAGLAB_API_HOST=0.0.0.0
RAGLAB_API_PORT=8000
RAGLAB_API_CORS_ORIGINS=["http://localhost:5173","http://localhost:8081","http://127.0.0.1:5173","http://127.0.0.1:8081"]
RAGLAB_ADMINER_URL=http://localhost:8080

# Durcissement API (docs/api-production.md). Budgets par etape en secondes,
# 0 = sans limite. Cle vide = authentification desactivee ; limite 0 = desactivee.
RAGLAB_EMBED_TIMEOUT_SECONDS=30
RAGLAB_RETRIEVAL_TIMEOUT_SECONDS=15
RAGLAB_OLLAMA_RETRY_AFTER_SECONDS=30
RAGLAB_READY_TIMEOUT_SECONDS=3
RAGLAB_API_KEY=
RAGLAB_API_RATE_LIMIT_REQUESTS=0
RAGLAB_API_RATE_LIMIT_WINDOW_SECONDS=60

# Collecte des sources officielles (/api/sources, raglab sources fetch).
# Budget de toute la tache (0 = sans limite), d'un appel git, et rythme CELLAR.
RAGLAB_SOURCE_FETCH_TIMEOUT_SECONDS=3600
RAGLAB_LEGIFRANCE_GIT_TIMEOUT_SECONDS=600
RAGLAB_EURLEX_REQUEST_DELAY_SECONDS=1
RAGLAB_EURLEX_REQUEST_TIMEOUT_SECONDS=60

# Serveur llama.cpp optionnel (API compatible OpenAI), utilise pour generer les
# questions LexML et, en 9.1b, pour le juge RAGAS. {profile} = profil de Start-LocalLLM.ps1.
RAGLAB_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# RAGLAB_LLAMACPP_START_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File C:\chemin\lamacpp\Start-LocalLLM.ps1 {profile}
# RAGLAB_LLAMACPP_STOP_COMMAND=powershell -NoProfile -ExecutionPolicy Bypass -File C:\chemin\lamacpp\Stop-LocalLLM.ps1
RAGLAB_LLAMACPP_API_KEY=

# Fournisseurs de generation proposes (ollama, llamacpp, vllm), voir docs/api-production.md.
# llama-server n'est pas demarre pour une requete interactive : il doit deja tourner.
RAGLAB_LLM_PROVIDERS=ollama
RAGLAB_DEFAULT_LLM_PROVIDER=ollama
RAGLAB_VLLM_BASE_URL=http://127.0.0.1:8001/v1
RAGLAB_VLLM_API_KEY=

# Citations juridiques (« art. 49 da Lei nº 8.078 ») : restreindre a la loi citee, epingler l'article.
RAGLAB_CITATION_RESOLVER=true

# Graphe des renvois dans Neo4j (docs/graphe.md). Construit apres chaque
# indexation quand Neo4j repond ; profil force par corpus si besoin.
RAGLAB_NEO4J_URI=bolt://localhost:7687
RAGLAB_GRAPH_BUILD_ON_INDEX=true
# RAGLAB_GRAPH_PROFILES={"bench_lexml_pt": "laws"}
# Branche de recherche graphe (9.9b) : desactivee tant qu'elle n'est pas mesuree.
RAGLAB_GRAPH_RETRIEVAL=false
RAGLAB_GRAPH_WEIGHT=0.5
# Store a entites de la phase 8 (jamais mesure) : pages Expert masquees par defaut.
RAGLAB_ENTITY_GRAPH_ENABLED=false

# Versions des articles (9.10, docs/versions.md) : in_force (en vigueur aujourd'hui,
# ou a la date que demande la question), all (comme un RAG classique), as_of=AAAA-MM-JJ.
# in_force mesure : jeu « versions » Recall@5 0,75 -> 0,93 (docs/versions.md).
RAGLAB_VERSIONS_DEFAULT=in_force
